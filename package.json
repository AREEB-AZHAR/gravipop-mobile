{
  "name": "gravipop-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GraviPop: Stellar Conservatory — Modern Vite Web Edition",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:android": "node scripts/build-android.mjs",
    "test:web": "node scripts/test-submit.mjs && node scripts/test-ads.mjs && node scripts/test-leaderboard.mjs",
    "leaderboard:list": "node scripts/manage-leaderboard.mjs list",
    "leaderboard:delete": "node scripts/manage-leaderboard.mjs delete",
    "leaderboard:clear": "node scripts/manage-leaderboard.mjs clear",
    "build:all": "npm run build:wasm && npm run build",
    "check:secrets": "node scripts/check-secrets.mjs",
    "start": "node server.mjs"
  },
  "devDependencies": {
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "firebase": "^13.0.0"
  }
}
