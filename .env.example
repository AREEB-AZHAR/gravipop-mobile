# Google Ad Manager web ads: test uses Google's official demo inventory.
# Set off to disable all ads, or live after adding your own unit paths.
VITE_ADS_MODE=test
VITE_GOOGLE_AD_REWARDED_UNIT=
VITE_GOOGLE_AD_INTERSTITIAL_UNIT=
VITE_GOOGLE_AD_SIDEBAR_LEFT_UNIT=
VITE_GOOGLE_AD_SIDEBAR_RIGHT_UNIT=
# Optional shared API override; Vercel and Vite use /api/leaderboard by default.
# Static-only hosts can use https://graviity-zeta.vercel.app/api/leaderboard.
VITE_LEADERBOARD_URL=

# Dreamlo Global Leaderboard API Keys (Server-side / API functions only)
# Never expose DREAMLO_PRIVATE_KEY in client bundles or public repositories.
DREAMLO_PUBLIC_CODE=
DREAMLO_PRIVATE_KEY=

# Firebase Web App Configuration (Vite client-side)
# Required for Firebase Analytics and Hosting integration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
